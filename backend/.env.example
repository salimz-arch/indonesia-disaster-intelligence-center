# ═══ IDIC Backend Environment ═══
# Salin menjadi .env:  cp .env.example .env
# JANGAN commit file .env

# ── Application ──
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── CORS (origin frontend, pisahkan dengan koma) ──
CORS_ORIGINS=http://localhost:3000

# ── Database ──
# Development: SQLite async. Production (Step 3): PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./idic.db
# DATABASE_URL=postgresql+asyncpg://idic:idic@localhost:5432/idic

# ── Redis (dipakai mulai Step 5) ──
REDIS_URL=redis://localhost:6379/0

# ── Interval koleksi data (detik) ──
EARTHQUAKE_REFRESH_SECONDS=60
WEATHER_REFRESH_SECONDS=600
RAINFALL_REFRESH_SECONDS=900

# ── AI provider: mock | gemini | openai ──
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=